SESSION_SECRET=ganti-dengan-string-acak-minimal-32-karakter

# --- FIREBASE ---
# Di lokal bisa pakai path file, di Vercel copy seluruh isi JSON ke FIREBASE_SERVICE_ACCOUNT_JSON
FIREBASE_SERVICE_ACCOUNT_PATH=serviceAccountKey.json
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# --- GOOGLE OAUTH ---
# Di lokal bisa pakai file client_secret.json, di Vercel copy seluruh isi JSON ke GOOGLE_CLIENT_SECRET_JSON
OAUTH_CLIENT_SECRET=client_secret.json
# GOOGLE_CLIENT_SECRET_JSON={"web":{"client_id":"...",...}}
GOOGLE_REDIRECT_URI=https://cakapin.biz.id/auth/google/callback

# --- MIDTRANS (PAYMENT GATEWAY) ---
# Wajib dimasukkan ke Vercel Environment Variables:
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxx
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxx
NEXT_PUBLIC_MIDTRANS_IS_PRODUCTION=false
